# ─────────────────────────────────────────────────────────────────────
# KLYZ execution infrastructure
# Copy to .env and adjust. Every value below is the documented default;
# production requires KLYZ_REDIS_URL to be set explicitly.
# ─────────────────────────────────────────────────────────────────────

# Queue transport: "redis" (BullMQ, the production path) or "memory"
# (in-process, used automatically by the unit-test suite).
KLYZ_QUEUE_DRIVER=redis

# Redis connection. redis:// or rediss://. Required in production.
KLYZ_REDIS_URL=redis://127.0.0.1:6379

# BullMQ queue name — one queue per deployment.
KLYZ_QUEUE_NAME=workflow-executions

# Executions processed in parallel by one worker process (1-64).
KLYZ_WORKER_CONCURRENCY=4

# Transport-level job attempts for infrastructure failures (1-10).
# Node-level retries are configured per run in the editor.
KLYZ_JOB_ATTEMPTS=3
KLYZ_JOB_BACKOFF_MS=2000

# Overall execution watchdog in ms; pauses while a run is "waiting"
# (delay nodes). 0 disables it.
KLYZ_EXECUTION_TIMEOUT_MS=900000

# How often the worker re-reads cancel_requested for active runs (ms).
KLYZ_CANCEL_POLL_MS=1000

# ─────────────────────────────────────────────────────────────────────
# Triggers: the schedule loop and inbound webhook ceilings
# ─────────────────────────────────────────────────────────────────────

# Run the schedule trigger loop in the worker. Turning it off leaves
# every trigger row, cron expression and next-run time intact — the
# card still shows when a schedule would fire, it simply never starts
# one. Set to "false" on a read-only replica or a staging box.
KLYZ_SCHEDULER_ENABLED=true

# How often the worker checks for schedules that are due (1000-3600000
# ms). Cadence only: an occurrence missed while the worker was down is
# not replayed — the cursor jumps to the next future run.
KLYZ_SCHEDULER_INTERVAL_MS=15000

# Schedule rows examined in one tick (1-500).
KLYZ_SCHEDULER_BATCH=50

# Inbound webhook deliveries allowed per minute from one client IP
# (1-60000). The per-workspace publish ceiling is fixed at 30/min.
KLYZ_WEBHOOK_RATE_LIMIT=600

# AES-256-GCM key for credential + webhook secret encryption.
# 32 bytes, hex or base64. In development a key file is generated at
# .klyz/credentials.key when this is unset; in production it is required.
KLYZ_CREDENTIAL_KEY=

# Absolute base URL shown for published webhook endpoints
# (defaults to a relative URL when unset).
KLYZ_PUBLIC_URL=http://localhost:3000

# HTTP node egress policy. Comma-separated host[:port] list; "*" allows
# any public host. Private/loopback/link-local targets are blocked
# unless KLYZ_HTTP_ALLOW_PRIVATE=true (needed for local test servers).
KLYZ_HTTP_ALLOW_HOSTS=
KLYZ_HTTP_ALLOW_PRIVATE=false
KLYZ_HTTP_MAX_RESPONSE_BYTES=1048576

# PostgreSQL integration target (docker compose service "postgres").
# Used by the postgres integration tests and the demo database.
KLYZ_PG_URL=postgres://klyz:klyz@127.0.0.1:5432/klyz_integrations

# ─────────────────────────────────────────────────────────────────────
# Identity, sessions and access control
# Nothing here is required to run locally: safe defaults apply.
# ─────────────────────────────────────────────────────────────────────

# Allow self-service account creation at /login. Set to "false" on a
# deployment where an operator provisions accounts, so registration
# answers 403 REGISTRATION_DISABLED.
KLYZ_ALLOW_REGISTRATION=true

# Failed sign-ins allowed per minute for one email address.
# The per-IP ceiling is three times this value.
KLYZ_LOGIN_RATE_LIMIT=10

# New accounts allowed per hour from one IP address.
KLYZ_REGISTER_RATE_LIMIT=10

# ─────────────────────────────────────────────────────────────────────
# Providers (OAuth): GitHub, Gmail, Google Sheets, Notion, Slack
# Leave unset in development to disable them: the Integrations page
# still renders, and Connect answers 422 PROVIDER_NOT_CONFIGURED with
# the missing variable named — nothing crashes.
# ─────────────────────────────────────────────────────────────────────

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# The authorization callback URL must match GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Defaults to KLYZ_PUBLIC_URL + /api/providers/github/callback.
GITHUB_CALLBACK_URL=

# Google OAuth client (type "Web application") — shared by Gmail and
# Google Sheets, each with its own redirect URI.
# The authorized redirect URIs must match both callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to KLYZ_PUBLIC_URL + /api/providers/gmail/callback.
GOOGLE_CALLBACK_URL=
# Defaults to KLYZ_PUBLIC_URL + /api/providers/google_sheets/callback.
GOOGLE_SHEETS_CALLBACK_URL=

# Notion internal integration (notion.so/my-integrations). Notion asks
# for the client id/secret as HTTP Basic and has no scope parameter —
# what the integration may touch is chosen in Notion's admin console.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Defaults to KLYZ_PUBLIC_URL + /api/providers/notion/callback.
NOTION_CALLBACK_URL=

# Slack app (api.slack.com/apps → OAuth & Permissions).
# The redirect URL must match SLACK_CALLBACK_URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Defaults to KLYZ_PUBLIC_URL + /api/providers/slack/callback.
SLACK_CALLBACK_URL=
# Slack app → Basic Information → Signing Secret. Required before a
# Slack trigger receives anything: without it the endpoint publishes in
# an error state and every delivery is refused rather than accepted
# unsigned. Set it, then publish the endpoint again.
SLACK_SIGNING_SECRET=

# Optional scope overrides (comma or space separated).
# GitHub defaults to public_repo; add "repo" for private repositories and
# "admin:repo_hook" so KLYZ can create repository hooks for you — without
# it the endpoint card falls back to manual hook instructions.
KLYZ_GITHUB_SCOPES=
# Gmail defaults to gmail.send, gmail.modify, gmail.readonly, openid, email.
KLYZ_GOOGLE_SCOPES=
# Google Sheets defaults to the spreadsheets scope plus openid/email —
# never Drive: KLYZ never lists or creates files.
KLYZ_GOOGLE_SHEETS_SCOPES=
# Slack defaults to chat:write, channels:read, groups:read,
# channels:history, groups:history — bot scopes only.
KLYZ_SLACK_SCOPES=

# Cloud Pub/Sub topic that Gmail's users.watch pushes to. Empty disables
# push entirely: no delivery reaches the endpoint, so a Gmail trigger only
# fires when you run the workflow yourself.
GOOGLE_PUBSUB_TOPIC=


# ─────────────────────────────────────────────────────────────────────
# AI workflow builder (/ai) and AI steps — optional
# Any OpenAI-compatible chat-completions endpoint. Unset key = the
# builder is off (routes answer AI_CONFIGURATION_MISSING with setup
# guidance). The key stays server-side: it is only ever attached to the
# outbound request, never returned, logged or sent to the browser.
# ─────────────────────────────────────────────────────────────────────
# "openai" = the endpoint configured below. "mock" = a deterministic
# local stand-in for tests and development; it needs no key and is
# refused outright when NODE_ENV=production.
KLYZ_AI_PROVIDER=openai
KLYZ_AI_API_KEY=
# Model id for the provider above.
KLYZ_AI_MODEL=openai/gpt-4o-mini
# Base URL without a trailing slash.
KLYZ_AI_BASE_URL=https://openrouter.ai/api/v1
# Per-request timeout in ms (1000-300000).
KLYZ_AI_TIMEOUT_MS=45000
# Completion budget in tokens (256-16384).
KLYZ_AI_MAX_TOKENS=4096
# Requests per minute per workspace (1-600). In-process window.
KLYZ_AI_RATE_LIMIT=30
# Character limit for the written description (200-32000).
KLYZ_AI_MAX_INTENT_CHARS=4000
